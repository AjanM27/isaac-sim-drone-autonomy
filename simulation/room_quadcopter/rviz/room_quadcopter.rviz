Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /TF1
        - /PointCloud21
    Tree Height: 600
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Ground Grid
      Plane: XY
      Plane Cell Count: 20
      Cell Size: 1
      Reference Frame: world
      Alpha: 0.5
    - Class: rviz_default_plugins/TF
      Enabled: true
      Name: TF
      Frame Timeout: 15
      Marker Scale: 1
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Update Interval: 0
    - Class: rviz_default_plugins/RobotModel
      Collision Enabled: false
      Description File: simulation/room_quadcopter/rviz/iris_visual.urdf
      Description Source: File
      Enabled: true
      Links:
        All Links Enabled: true
        Expand Joint Details: false
        Expand Link Details: false
        Expand Tree: false
        Link Tree Style: Links in Alphabetic Order
      Name: Iris Drone Model
      TF Prefix: ""
      Update Interval: 0
      Visual Enabled: true
    - Class: rviz_default_plugins/Axes
      Enabled: true
      Length: 0.4
      Name: Drone Body Axes
      Radius: 0.015
      Reference Frame: drone_base
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: Ouster OS1 3D LiDAR
      Topic:
        Value: /lidar/points
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 10
      Style: Points
      Size (Pixels): 2
      Size (m): 0.01
      Decay Time: 0.3
      Position Transformer: XYZ
      Color Transformer: AxisColor
      Axis: Z
      Use Fixed Frame: true
    - Class: rviz_default_plugins/Map
      Enabled: false
      Name: Legacy 2D Occupancy Map
      Topic:
        Value: /map
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 1
      Alpha: 0.55
      Color Scheme: map
      Draw Behind: true
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: Exploration Planned Path 3D
      Topic:
        Value: /exploration/planned_path_3d
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 1
      Line Style: Lines
      Line Width: 0.06
      Color: 0; 255; 80
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Exploration Frontiers
      Topic:
        Value: /exploration/voxel_markers
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 1
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: RTAB-Map OctoMap Occupied Space
      Topic:
        Value: /octomap_occupied_space
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 1
      Style: Boxes
      Size (Pixels): 2
      Size (m): 0.15
      Decay Time: 0
      Position Transformer: XYZ
      Color Transformer: AxisColor
      Axis: Z
      Use Fixed Frame: true
    - Class: rviz_default_plugins/PointCloud2
      Enabled: false
      Name: RTAB-Map OctoMap Global Frontiers
      Topic:
        Value: /octomap_global_frontier_space
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 1
      Style: Points
      Size (Pixels): 3
      Size (m): 0.08
      Decay Time: 0
      Position Transformer: XYZ
      Color Transformer: FlatColor
      Color: 255; 70; 255
      Use Fixed Frame: true
    - Class: rviz_default_plugins/PointCloud2
      Enabled: false
      Name: Exploration Occupied Voxels
      Topic:
        Value: /exploration/occupied_voxels
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 1
      Style: Boxes
      Size (Pixels): 3
      Size (m): 0.3
      Decay Time: 0
      Position Transformer: XYZ
      Color Transformer: AxisColor
      Axis: Z
      Use Fixed Frame: true
    - Class: rviz_default_plugins/PointCloud2
      Enabled: false
      Name: Exploration Free Voxels (diagnostic)
      Topic:
        Value: /exploration/free_voxels
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 1
      Style: Points
      Size (Pixels): 1
      Size (m): 0.03
      Decay Time: 0
      Position Transformer: XYZ
      Color Transformer: FlatColor
      Color: 60; 120; 255
      Use Fixed Frame: true
    - Class: rviz_default_plugins/PointCloud2
      Enabled: false
      Name: Exploration Uncertain Voxels (diagnostic)
      Topic:
        Value: /exploration/uncertain_voxels
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 1
      Style: Points
      Size (Pixels): 2
      Size (m): 0.05
      Decay Time: 0
      Position Transformer: XYZ
      Color Transformer: FlatColor
      Color: 255; 170; 0
      Use Fixed Frame: true
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: RTAB-Map 3D Cloud Map
      Topic:
        Value: /cloud_map
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 1
      Style: Points
      Size (Pixels): 2
      Size (m): 0.025
      Decay Time: 0
      Position Transformer: XYZ
      Color Transformer: AxisColor
      Axis: Z
      Use Fixed Frame: true
    - Class: rviz_default_plugins/Axes
      Enabled: true
      Length: 0.5
      Name: SLAM Estimated Pose
      Radius: 0.02
      Reference Frame: slam_base
    - Class: rviz_default_plugins/Odometry
      Enabled: true
      Name: ICP Odometry
      Topic:
        Value: /slam/odom
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 10
      Keep: 100
      Shape:
        Value: Arrow
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: RTAB-Map Trajectory
      Topic:
        Value: /mapPath
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Line Style: Lines
      Line Width: 0.03
      Color: 255; 170; 0
    - Class: rviz_default_plugins/Range
      Alpha: 0.6
      Buffer Length: 1
      Color: 255; 85; 0
      Enabled: true
      Name: Downward ToF
      Topic:
        Value: /range/down
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 10
    - Class: rviz_default_plugins/Range
      Alpha: 0.6
      Buffer Length: 1
      Color: 85; 255; 255
      Enabled: true
      Name: Upward ToF
      Topic:
        Value: /range/up
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 10
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: Front Camera
      Topic:
        Value: /camera/front/image_raw
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 10
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 8
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Pitch: 0.7
      Yaw: 0.8
Window Geometry:
  Height: 900
  Width: 1400
